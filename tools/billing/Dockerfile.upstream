FROM --platform=$BUILDPLATFORM golang:1.26 AS build
ARG TARGETOS TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY internal/testservices/upstream ./internal/testservices/upstream
RUN CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" go build -trimpath -ldflags="-s -w" -o /upstream ./internal/testservices/upstream

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /upstream /upstream
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/upstream"]
